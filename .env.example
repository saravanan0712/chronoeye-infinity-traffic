# ==============================================================================
# ChronoEye Infinity — Environment Configuration Template (.env.example)
# Copy this file to .env and configure local execution parameters.
# ==============================================================================

# Server & API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Hardware Device Configuration
DEVICE=cpu                     # "cpu" or "cuda"
EASYOCR_GPU=False              # True if CUDA GPU is available for OCR

# Computer Vision & Perception Parameters (Module 1)
MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.50
OCR_CONFIDENCE_THRESHOLD=0.60
TRACK_BUFFER_FRAMES=30

# Multi-Camera Re-Identification & Journey Parameters (Module 2)
REID_DISTANCE_THRESHOLD=0.35
TEMPORAL_WINDOW_SECONDS=300
MAX_UNOBSERVED_GAP_SECONDS=600

# Spatio-Temporal Forecasting & ST-GNN Parameters (Module 3)
PEMS08_DATASET_PATH=data/research/pems08/PEMS08.npz
PEMS08_TOPOLOGY_PATH=data/research/pems08/PEMS08.csv
STGNN_CHECKPOINT_PATH=experiments/module3/research_exp_02/checkpoints/best_stgnn_model.pt
STGNN_HISTORY_STEPS=12
STGNN_FORECAST_HORIZONS=["PLUS_5MIN", "PLUS_10MIN", "PLUS_15MIN"]
